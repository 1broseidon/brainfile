{
  "name": "@brainfile/cli",
  "version": "0.3.0",
  "description": "Command-line interface for Brainfile task management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "brainfile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "brainfile",
    "task-management",
    "cli",
    "productivity"
  ],
  "author": "Brainfile Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brainfile/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@brainfile/core": "^0.3.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "../../build"
  }
}
