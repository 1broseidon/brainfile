{
  "name": "brainfile",
  "version": "0.19.0",
  "description": "Command-line interface for Brainfile task management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "brainfile": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:lib && npm run build:bundle && npm run copy-schemas",
    "build:lib": "tsc -p tsconfig.lib.json",
    "build:bundle": "node scripts/build-bundle.mjs",
    "copy-schemas": "mkdir -p dist/schemas && cp src/schemas/*.json dist/schemas/",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "test": "node scripts/run-jest.mjs",
    "test:watch": "node scripts/run-jest.mjs --watch",
    "test:coverage": "node scripts/run-jest.mjs --coverage",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "brainfile",
    "task-management",
    "cli",
    "productivity"
  ],
  "author": "Brainfile Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1broseidon/brainfile"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@brainfile/core": "^0.19.0",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "js-yaml": "^4.1.0",
    "open": "^10.1.0",
    "react": "^19.2.8",
    "zod": "4.3.6",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "../../build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
