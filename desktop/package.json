{
  "name": "brainfile-desktop",
  "productName": "Brainfile",
  "private": true,
  "version": "0.1.0",
  "description": "Brainfile for the desktop: every repository's board in one window.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:core && npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:core": "npm run build --prefix ../core",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.json --threshold error",
    "package": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@brainfile/core": "file:../core"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "md.brainfile.desktop",
    "productName": "Brainfile",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "file:../../../core": false
  }
}
