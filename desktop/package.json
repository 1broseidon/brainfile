{
  "name": "brainfile-desktop",
  "productName": "Brainfile",
  "private": true,
  "version": "0.1.0",
  "description": "Brainfile for the desktop: every repository's board in one window.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:core && npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:core": "npm run build --prefix ../core",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.json --threshold error",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/",
    "package": "npm run build && electron-builder --mac --dir --arm64",
    "icons": "electron scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@brainfile/core": "file:../core",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "md.brainfile.desktop",
    "productName": "Brainfile",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/*.js",
      "package.json"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "file:../../../core": false
  }
}
