{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/host/**/*", "src/agents/**/*", "src/link/**/*", "src/preload/**/*", "src/shared/**/*"]
}
